[Unit]
Description=AI Orchestrator Agentic Team UI Service
After=network.target
Documentation=https://github.com/hoangsonww/AI-Agents-Orchestrator

[Service]
Type=simple
User=orchestrator
Group=orchestrator
WorkingDirectory=/opt/ai-orchestrator
Environment="PATH=/opt/ai-orchestrator/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="AGENTIC_UI_BACKEND_PORT=5002"
EnvironmentFile=/etc/ai-orchestrator/environment

ExecStartPre=/bin/mkdir -p /var/log/ai-orchestrator
ExecStartPre=/bin/mkdir -p /var/lib/ai-orchestrator/{output,workspace,reports,sessions}

ExecStart=/opt/ai-orchestrator/venv/bin/python /opt/ai-orchestrator/ui/agentic_app.py

Restart=always
RestartSec=10s
StartLimitInterval=200
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-orchestrator /var/log/ai-orchestrator

LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=2G
CPUQuota=200%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-team

[Install]
WantedBy=multi-user.target
